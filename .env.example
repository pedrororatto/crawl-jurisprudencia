# Copie para .env e ajuste conforme o ambiente.
JURIS_DATABASE_URL=postgresql+asyncpg://juris:juris@localhost:5432/juris
# Data inicial do backfill (primeira coleta de cada tema), formato ISO.
JURIS_BACKFILL_INICIO=2020-01-01
# Margem (dias) subtraída do watermark a cada rodada, para pegar registros atrasados.
JURIS_WATERMARK_MARGEM_DIAS=2
# Limite de páginas por tema em cada rodada (20 resultados/página no CJSG).
JURIS_MAX_PAGINAS_POR_RODADA=50
# Intervalo mínimo entre requisições ao tribunal (segundos).
JURIS_REQ_INTERVALO_SEGUNDOS=2.0
